DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker
TEST_DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker_test

# Leave empty to use credentials from `ant auth login`
ANTHROPIC_API_KEY=

WRITER_MODEL=claude-opus-5-5
EXTRACTION_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-4-5

# Embeddings only (Stage 5)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b

STORAGE_DIR=./storage
