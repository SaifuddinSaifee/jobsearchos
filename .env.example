# Host port for the Postgres container (change it, and both URLs, if 5432 is taken)
POSTGRES_PORT=5433
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5433/jobtracker
TEST_DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5433/jobtracker_test

# Together AI (https://api.together.ai/settings/api-keys)
TOGETHER_AI_API_KEY=

# Together model IDs
WRITER_MODEL=MiniMaxAI/MiniMax-M3
EXTRACTION_MODEL=zai-org/GLM-5.3-Flash
FAST_MODEL=zai-org/GLM-5.3-Flash

# Embeddings only (Stage 5)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b

# Gmail for cold email (README: "Setup: Gmail"). Redirect URI: APP_URL + /api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Encrypts stored Gmail tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Prospeo: finds people at a company and reveals verified emails (optional, https://prospeo.io)
PROSPEO_API_KEY=

# Job extractions processed at the same time in the background queue (1-5)
QUEUE_CONCURRENCY=2

# Arize Phoenix: traces every model call (optional, docs/LLM-LOGGING.md). Leave the endpoint empty to turn tracing off;
# the numbers for each call (tokens, cost, time) are recorded in the database either way and shown on the AI usage page.
# Prompts and replies appear in Phoenix only. To keep them out, set OPENINFERENCE_HIDE_INPUTS=true and
# OPENINFERENCE_HIDE_OUTPUTS=true.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=jobsearchos
PHOENIX_API_KEY=
# Where your browser reaches Phoenix (the AI usage page links to it). Defaults to the endpoint above.
PHOENIX_UI_URL=

STORAGE_DIR=./storage
